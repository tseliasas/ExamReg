<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanguageExamApp.DashboardWindow"
        Title="Student Dashboard" Width="600" Height="600"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel Spacing="15" Margin="30">
        
        <!-- Section 1: Available Exams -->
        <TextBlock Text="Available Exam Sessions" FontSize="18" FontWeight="Bold"/>
        <ListBox Name="lstAvailableExams" Height="150" Background="#000000" CornerRadius="5"/>
        
        <!-- Section 2: Registration Action -->
        <TextBlock Text="Enter the ID of the exam to register:" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Name="txtExamID" Width="100" PlaceholderText="Exam ID"/>
            <Button Name="btnRegister" Content="Register" Background="#0078D7" Foreground="White" Width="100" Click="BtnRegister_Click"/>
        </StackPanel>
        <TextBlock Name="txtFeedback" Text="" FontWeight="Bold"/>

        <!-- Section 3: The User's Schedule -->
        <TextBlock Text="My Registered Exams" FontSize="18" FontWeight="Bold" Margin="0,20,0,0"/>
        <ListBox Name="lstMyExams" Height="150" Background="#000000" CornerRadius="5"/>
        
    </StackPanel>
</Window>