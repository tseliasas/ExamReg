<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanguageExamApp.MainWindow"
        Title="Language Exam Login" Width="400" Height="300"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel Spacing="20" Margin="50" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Student Email:" FontWeight="Bold"/>
        <TextBox Name="txtEmail" Width="250" PlaceholderText="Enter your email..."/>
        
        <TextBlock Text="Password:" FontWeight="Bold"/>
        <TextBox Name="txtPassword" Width="250" PasswordChar="*" PlaceholderText="Enter your password..."/>
        
        <Button Name="btnLogin" Content="Login" Width="250" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="BtnLogin_Click"/>
    </StackPanel>
</Window>